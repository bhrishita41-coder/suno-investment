$('micCheck').onclick=async()=>{
 if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){note("This browser or page cannot use the microphone. Open the page in Chrome in its own tab.");return}
 try{const s=await navigator.mediaDevices.getUserMedia({audio:true});s.getTracks().forEach(t=>t.stop());beep(660);
  note("Microphone is on and ready. You can now use Speak a command and Start recording.")}
 catch(e){note(e.name==='NotFoundError'?"No microphone was found. Connect one and try again.":
